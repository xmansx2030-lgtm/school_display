# Copy to .env.production on the server and replace every CHANGE_ME value.
# Never commit .env.production.

POSTGRES_DB=school_display
POSTGRES_USER=school_display
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://school_display:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/school_display
PGSSLMODE=disable

REDIS_CACHE_PASSWORD=CHANGE_ME_CACHE_PASSWORD
REDIS_CHANNELS_PASSWORD=CHANGE_ME_CHANNELS_PASSWORD
REDIS_CACHE_URL=redis://:CHANGE_ME_CACHE_PASSWORD@redis-cache:6379/0
CACHE_REDIS_URL=redis://:CHANGE_ME_CACHE_PASSWORD@redis-cache:6379/0
REDIS_CHANNELS_URL=redis://:CHANGE_ME_CHANNELS_PASSWORD@redis-channels:6379/0
CHANNELS_REDIS_URL=redis://:CHANGE_ME_CHANNELS_PASSWORD@redis-channels:6379/0
REDIS_MAX_CONNECTIONS=100
CACHE_REDIS_MAX_CONNECTIONS=100

SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY
# Set this to the deployed Git commit hash and update it with every release.
APP_REVISION=CHANGE_ME_RELEASE_REVISION
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=school-display.com,www.school-display.com
CSRF_TRUSTED_ORIGINS=https://school-display.com,https://www.school-display.com
SITE_BASE_URL=https://school-display.com
DISPLAY_PUBLIC_BASE_URL=https://school-display.com
DISPLAY_PAIRING_TTL_SEC=600
DISPLAY_PAIRING_START_LIMIT=20
DISPLAY_PAIRING_CODE_ATTEMPTS=8
WEB_CONCURRENCY=2

# ─────────────────────────────────────────────────────────────────────────
# Tamara — HIDDEN FOR NOW.
#
# TAMARA_TEMPORARILY_HIDDEN defaults to True, which forces TAMARA_ENABLED off
# no matter what is set below. Nothing here needs configuring while the
# provider stays hidden; the block is kept so re-enabling is a one-line change.
#
# To bring it back:
#   TAMARA_TEMPORARILY_HIDDEN=False
#   TAMARA_ENABLED=True   (+ real tokens, + the "tamara" compose profile)
# ─────────────────────────────────────────────────────────────────────────
TAMARA_TEMPORARILY_HIDDEN=True
# TAMARA_ENABLED=False
# TAMARA_API_BASE_URL=https://api-sandbox.tamara.co
# TAMARA_API_TOKEN=CHANGE_ME_TAMARA_API_TOKEN
# Alternative for Docker secrets: TAMARA_API_TOKEN_FILE=/run/secrets/tamara_api_token
# TAMARA_NOTIFICATION_TOKEN=CHANGE_ME_TAMARA_NOTIFICATION_TOKEN
# Alternative: TAMARA_NOTIFICATION_TOKEN_FILE=/run/secrets/tamara_notification_token
# TAMARA_CALLBACK_BASE_URL=https://school-display.com
# TAMARA_HTTP_TIMEOUT_SECONDS=15
# TAMARA_ELIGIBILITY_TIMEOUT_SECONDS=0.2
# TAMARA_CAPTURE_DIGITAL_ORDERS=True
# TAMARA_RECONCILIATION_INTERVAL_SECONDS=10
# TAMARA_RECONCILIATION_BATCH_SIZE=20
# TAMARA_RECONCILIATION_WORKER_MEMORY_LIMIT=192m

# Moyasar card checkout. Keep test mode isolated until the merchant account is
# activated, then replace both keys and set MOYASAR_LIVE_MODE=True.
MOYASAR_ENABLED=False
MOYASAR_LIVE_MODE=False
MOYASAR_ACTIVATE_TEST_PAYMENTS=False
MOYASAR_API_BASE_URL=https://api.moyasar.com/v1
MOYASAR_PUBLISHABLE_KEY=CHANGE_ME_MOYASAR_PUBLISHABLE_KEY
# Alternative: MOYASAR_PUBLISHABLE_KEY_FILE=/run/secrets/moyasar_publishable_key
MOYASAR_SECRET_KEY=CHANGE_ME_MOYASAR_SECRET_KEY
# Alternative: MOYASAR_SECRET_KEY_FILE=/run/secrets/moyasar_secret_key
MOYASAR_WEBHOOK_SECRET=CHANGE_ME_MOYASAR_WEBHOOK_SECRET
# Alternative: MOYASAR_WEBHOOK_SECRET_FILE=/run/secrets/moyasar_webhook_secret
MOYASAR_CALLBACK_BASE_URL=https://school-display.com
MOYASAR_HTTP_TIMEOUT_SECONDS=15
# Wallets convert far better than raw card entry. Apple Pay additionally
# requires domain verification inside the Moyasar dashboard.
# applepay needs an apple_pay config block + Apple merchant-domain verification;
# without it Moyasar rejects the whole form. Keep it out until that is set up.
MOYASAR_PAYMENT_METHODS=creditcard,stcpay
MOYASAR_SUPPORTED_NETWORKS=mada,visa,mastercard
# Reconciliation recovers payments whose callback and webhook both failed.
MOYASAR_RECONCILIATION_INTERVAL_SECONDS=60
MOYASAR_RECONCILIATION_BATCH_SIZE=20
MOYASAR_RECONCILIATION_LOOKBACK_HOURS=72
MOYASAR_RECONCILIATION_MAX_PAGES=5
MOYASAR_RECONCILIATION_WORKER_MEMORY_LIMIT=192m

# Commercial access control. Screens stop serving content once a school's
# subscription lapses; leave enabled unless diagnosing an outage.
DISPLAY_REQUIRE_ACTIVE_SUBSCRIPTION=True
SUBSCRIPTION_ACCESS_CACHE_TTL=300

# Screen add-on pricing (SAR per extra screen, per month).
SCREEN_ADDON_MONTHLY_PRICE=60
SCREEN_ADDON_SEMIANNUAL_MULTIPLIER=6
SCREEN_ADDON_ANNUAL_MULTIPLIER=10

# Email ownership verification. A verified address is required before checkout
# so invoices are deliverable; the link stays valid for one week by default.
EMAIL_VERIFICATION_TIMEOUT=604800

# Display bundle. Minified is ~54% smaller to parse on weak TV hardware.
# Set to False temporarily when you need readable stack traces from a screen.
DISPLAY_USE_MINIFIED_JS=True

# SMTP email used for password recovery, invoices, and system notifications.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_SMTP_USERNAME
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# Alternative: mount the SMTP password as a secret file and set this path.
EMAIL_HOST_PASSWORD_FILE=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=لوحة العرض الذكية <no-reply@school-display.com>
SERVER_EMAIL=لوحة العرض الذكية <no-reply@school-display.com>
PASSWORD_RESET_TIMEOUT=3600
TRANSACTIONAL_EMAIL_ENABLED=True
EMAIL_SUBSCRIPTION_EXPIRY_DAYS=14,7,3,1,0
EMAIL_NOTIFICATION_POLL_INTERVAL_SECONDS=30
EMAIL_NOTIFICATION_BATCH_SIZE=20
EMAIL_NOTIFICATION_MAX_ATTEMPTS=8
EMAIL_NOTIFICATION_WORKER_MEMORY_LIMIT=192m

# Telegram administrator alerts.
# Create the bot with @BotFather, send /start to it, then run:
#   python manage.py telegram_alert_chat_id
#   python manage.py telegram_alert_test
TELEGRAM_ALERTS_ENABLED=False
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME_TELEGRAM_PRIVATE_CHAT_ID
TELEGRAM_ALERTS_BASE_URL=https://school-display.com
TELEGRAM_ALERT_EXPIRY_DAYS=30,14,7,3,1,0
TELEGRAM_ALERT_HTTP_TIMEOUT_SECONDS=10
TELEGRAM_ALERT_POLL_INTERVAL_SECONDS=10
TELEGRAM_ALERT_BATCH_SIZE=20
TELEGRAM_ALERT_MAX_ATTEMPTS=10
TELEGRAM_ALERT_WORKER_MEMORY_LIMIT=192m

DISPLAY_WS_ENABLED=True
DISPLAY_WS_LIVE_STATUS_CHECK_SEC=60
WS_GROUP_EXPIRY=86400
WS_GROUP_REFRESH_INTERVAL_SECONDS=21600
DISPLAY_LAST_SEEN_DB_INTERVAL_SEC=60
DASHBOARD_SCREEN_LIVE_THRESHOLD_SEC=120
DISPLAY_WS_METRICS_KEY=CHANGE_ME_LONG_RANDOM_METRICS_KEY
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=8
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
TWO_FACTOR_REQUIRED_FOR_PRIVILEGED=True
TWO_FACTOR_ISSUER=School Display
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=8
CONTENT_SECURITY_POLICY_ENABLED=True
# Keep report-only until all remaining inline template scripts are migrated.
CONTENT_SECURITY_POLICY_REPORT_ONLY=True
CONTENT_SECURITY_POLICY_REPORT_URI=/csp-report/
CSP_REPORT_LOG_LIMIT_PER_MINUTE=5
DISPLAY_SNAPSHOT_ASYNC_BUILD=True
DISPLAY_SNAPSHOT_INLINE_FALLBACK=True
DISPLAY_START_EMBEDDED_SNAPSHOT_WORKER=False
DISPLAY_START_EMBEDDED_WAKE_SCHEDULER=False
DISPLAY_REQUIRE_REDIS_SPLIT=True

# Docker resource and log guards for the 2-vCPU / 4-GB production server.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILES=5
CADDY_MEMORY_LIMIT=192m
WEB_MEMORY_LIMIT=1024m
SNAPSHOT_WORKER_MEMORY_LIMIT=512m
WAKE_SCHEDULER_MEMORY_LIMIT=256m
POSTGRES_MEMORY_LIMIT=1024m
REDIS_CACHE_MEMORY_LIMIT=640m
REDIS_CHANNELS_MEMORY_LIMIT=384m
BACKUP_MEMORY_LIMIT=384m
BACKUP_CPU_LIMIT=0.50
REDIS_CACHE_MAXMEMORY=512mb
REDIS_CHANNELS_MAXMEMORY=256mb

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
FIREBASE_CREDENTIALS_BASE64=CHANGE_ME

# Optional encrypted off-site backups (Restic). Configure before enabling its cron file.
RESTIC_REPOSITORY=CHANGE_ME
RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM_BACKUP_PASSWORD
RESTIC_HOST=school-display-production
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
# 1=Monday .. 7=Sunday. Expensive prune/check runs only on this UTC weekday.
RESTIC_MAINTENANCE_WEEKDAY=7
# S3-compatible backends only:
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
