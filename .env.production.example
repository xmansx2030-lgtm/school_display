# Copy to .env.production on the server and replace every CHANGE_ME value.
# Never commit .env.production.

POSTGRES_DB=school_display
POSTGRES_USER=school_display
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://school_display:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/school_display
PGSSLMODE=disable

REDIS_CACHE_PASSWORD=CHANGE_ME_CACHE_PASSWORD
REDIS_CHANNELS_PASSWORD=CHANGE_ME_CHANNELS_PASSWORD
REDIS_CACHE_URL=redis://:CHANGE_ME_CACHE_PASSWORD@redis-cache:6379/0
CACHE_REDIS_URL=redis://:CHANGE_ME_CACHE_PASSWORD@redis-cache:6379/0
REDIS_CHANNELS_URL=redis://:CHANGE_ME_CHANNELS_PASSWORD@redis-channels:6379/0
CHANNELS_REDIS_URL=redis://:CHANGE_ME_CHANNELS_PASSWORD@redis-channels:6379/0
REDIS_MAX_CONNECTIONS=100
CACHE_REDIS_MAX_CONNECTIONS=100

SECRET_KEY=CHANGE_ME_DJANGO_SECRET_KEY
# Set this to the deployed Git commit hash and update it with every release.
APP_REVISION=CHANGE_ME_RELEASE_REVISION
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=school-display.com,www.school-display.com
CSRF_TRUSTED_ORIGINS=https://school-display.com,https://www.school-display.com
SITE_BASE_URL=https://school-display.com
DISPLAY_PUBLIC_BASE_URL=https://school-display.com
WEB_CONCURRENCY=2
DISPLAY_WS_ENABLED=True
DISPLAY_WS_LIVE_STATUS_CHECK_SEC=45
DISPLAY_LAST_SEEN_DB_INTERVAL_SEC=60
DASHBOARD_SCREEN_LIVE_THRESHOLD_SEC=120
DISPLAY_WS_METRICS_KEY=CHANGE_ME_LONG_RANDOM_METRICS_KEY
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_ACCOUNT_ATTEMPTS=8
LOGIN_RATE_LIMIT_IP_ATTEMPTS=30
TWO_FACTOR_REQUIRED_FOR_PRIVILEGED=True
TWO_FACTOR_ISSUER=School Display
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=8
CONTENT_SECURITY_POLICY_ENABLED=True
# Keep report-only until all remaining inline template scripts are migrated.
CONTENT_SECURITY_POLICY_REPORT_ONLY=True
CONTENT_SECURITY_POLICY_REPORT_URI=/csp-report/
CSP_REPORT_LOG_LIMIT_PER_MINUTE=5
DISPLAY_SNAPSHOT_ASYNC_BUILD=True
DISPLAY_SNAPSHOT_INLINE_FALLBACK=True
DISPLAY_START_EMBEDDED_SNAPSHOT_WORKER=False
DISPLAY_START_EMBEDDED_WAKE_SCHEDULER=False
DISPLAY_REQUIRE_REDIS_SPLIT=True

CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
FIREBASE_CREDENTIALS_BASE64=CHANGE_ME

# Optional encrypted off-site backups (Restic). Configure before enabling its cron file.
RESTIC_REPOSITORY=CHANGE_ME
RESTIC_PASSWORD=CHANGE_ME_LONG_RANDOM_BACKUP_PASSWORD
RESTIC_HOST=school-display-production
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
# S3-compatible backends only:
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
