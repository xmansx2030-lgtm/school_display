{
	servers {
		protocols h1 h2 h3
	}
}

school-display.com, www.school-display.com {
	encode zstd gzip

	# High-frequency display checks are measured inside the application. Keeping
	# them out of access logs prevents an always-on screen fleet from filling disk.
	@low_value_access_logs path /api/display/status* /api/display/snapshot* /api/display/live* /api/display/today* /api/display/ping/ /static/*
	log_skip @low_value_access_logs

	handle_path /static/* {
		root * /srv/static
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	reverse_proxy web:8000

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output stdout
		format json
	}
}
